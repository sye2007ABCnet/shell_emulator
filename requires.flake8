[flake8]
# Р2. Длина строки для Python (>80 символов)
max-line-length = 80

# Ц1. Цикломатическая сложность (>10)
max-complexity = 10

# А1. Максимальное число аргументов функций (>7)
max-parameters-amount = 7

# Ф1. Максимальная длина тела функции (>40 строк)
max-function-length = 40

# И1, М1, К1. Включаем проверку PEP8, магические числа и docstring
select = C,E,F,W,B,CFQ,D

# Игнорируем специфичные предупреждения docstring
ignore = D104,D105,D107,W503